# -----------------------------------------------------------------------------
# Revenue Autopilot — Environment Variables Template
# -----------------------------------------------------------------------------

# Database Configuration (PostgreSQL with pg driver adapter)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revenue_autopilot?schema=public"

# API Server Port
PORT=3001

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Execution Mode ('live' for live LLM + Razorpay APIs, 'simulated' for offline heuristic testing)
EXECUTION_MODE="simulated"

# Webhook Callback Base URL
CALLBACK_BASE_URL="http://localhost:3001"
